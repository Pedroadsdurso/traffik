# Postgres (Supabase). DATABASE_URL = transaction pooler (6543) para o app;
# DIRECT_URL = session pooler (5432) para as migrations do Prisma.
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres?sslmode=require"

# Redis — NÃO é usado (o BullMQ foi substituído por Vercel Cron). Mantido só
# porque ainda está no package.json; pode ficar vazio.
REDIS_URL=""

# Auth.js / NextAuth v5
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# URL pública da aplicação. É ela que entra nos scripts gerados (pixel e UTM) e
# nas URLs de webhook — em produção precisa ser o domínio real, senão o script
# instalado no site do cliente aponta para localhost e não reporta nada.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Criptografia em repouso das credenciais no banco (tokens da Conversions API,
# chaves de API). Gere com: openssl rand -base64 32
# ATENÇÃO: trocar esta chave torna ilegíveis os segredos já gravados.
ENCRYPTION_KEY="gere-com-openssl-rand-base64-32"

# Protege as rotas /api/cron/* (o Vercel Cron manda como Bearer).
CRON_SECRET="gere-com-openssl-rand-base64-32"

# Facebook Marketing API (Fase 6)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"
