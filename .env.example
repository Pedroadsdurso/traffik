# ─────────────────────────────────────────────────────────────────────────────
# ⛔ O .ENV LOCAL SEMPRE APONTA PARA DESENVOLVIMENTO.
#
# Existem DOIS bancos:
#   • PRODUÇÃO      ref dgaoucxkmpdxeenpfqth · us-east-1 · dados reais
#                   Vive SÓ nas Environment Variables da Vercel. Nunca aqui.
#   • DESENVOLVIMENTO  ref drdfnazladzkxlqpgdzt · ca-central-1 · dados falsos
#                   É este que vai no .env da sua máquina.
#
# Por quê: em 29/07/2026 um teste em localhost apagou configuração real porque
# os dois eram o MESMO banco. Ver o incidente no CLAUDE.md.
#
# Como conferir em qual você está:
#   • `npm run db:onde`  → imprime ref, região e se a escrita está liberada
#   • faixa amarela no topo do painel quando o banco NÃO é a produção
#
# `scripts/guard-db.mjs` é uma LISTA DE PERMISSÃO: script que escreve só roda
# em ref cadastrado como desenvolvimento. Projeto novo é bloqueado até ser
# classificado — a dúvida vira bloqueio, nunca liberação.
#
# Depois de trocar o banco: `npx prisma migrate deploy` e `npm run seed:dev`.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Supabase). DATABASE_URL = transaction pooler (6543) para o app;
# DIRECT_URL = session pooler (5432) para as migrations do Prisma.
# ⚠️ SEM `pgbouncer=true` — o Prisma 7 usa o driver adapter `pg`, que não o
# reconhece. O par correto é `sslmode=require&uselibpqcompat=true`.
DATABASE_URL="postgresql://postgres.[ref-de-DEV]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.[ref-de-DEV]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres?sslmode=require"

# Redis — NÃO é usado (o BullMQ foi substituído por Vercel Cron). Mantido só
# porque ainda está no package.json; pode ficar vazio.
REDIS_URL=""

# Auth.js / NextAuth v5
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# URL pública da aplicação. É ela que entra nos scripts gerados (pixel e UTM) e
# nas URLs de webhook — em produção precisa ser o domínio real, senão o script
# instalado no site do cliente aponta para localhost e não reporta nada.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Criptografia em repouso das credenciais no banco (tokens da Conversions API,
# chaves de API). Gere com: openssl rand -base64 32
# ATENÇÃO: trocar esta chave torna ilegíveis os segredos já gravados.
ENCRYPTION_KEY="gere-com-openssl-rand-base64-32"

# Protege as rotas /api/cron/* (o Vercel Cron manda como Bearer).
CRON_SECRET="gere-com-openssl-rand-base64-32"

# Facebook Marketing API (Fase 6)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"
