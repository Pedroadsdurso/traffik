// Traffik — schema completo
// Rastreamento de cliques/UTM, vendas via webhook, integração Facebook Ads,
// regras de automação, notificações e taxas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

/// Estados de uma venda, em ordem de avanço.
///
/// ⚠️ A ORDEM IMPORTA: o upsert monotônico (`ingestSale`) usa uma tabela de
/// força para decidir quem sobrescreve quem, porque o gateway não garante a
/// ordem de entrega e ainda reentrega o mesmo evento.
///
/// ABANDONADA < PENDENTE < EXPIRADA < APROVADA < (REEMBOLSADA/CHARGEBACK/CANCELADA)
enum SaleStatus {
  /// Chegou ao checkout e não gerou pagamento. NÃO é venda pendente.
  ABANDONADA
  /// Pagamento gerado (PIX, boleto), aguardando.
  PENDENTE
  /// O pagamento gerado venceu. Não é terminal: o cliente pode gerar outro e
  /// pagar — visto em produção (PIX_GENERATED -> PIX_EXPIRED -> PIX_GENERATED).
  EXPIRADA
  APROVADA
  REEMBOLSADA
  CHARGEBACK
  CANCELADA
}

enum PaymentMethod {
  PIX
  CARTAO
  BOLETO
  OUTRO
}

/// Estado de processamento de um payload recebido por webhook (Bloco 13).
enum WebhookLogStatus {
  /// Gravado assim que chega, antes de qualquer processamento.
  RECEBIDO
  /// Venda criada/atualizada com sucesso.
  PROCESSADO
  /// Recusado na validação (token inválido, webhook inativo, JSON quebrado).
  REJEITADO
  /// Estourou uma exceção durante o processamento.
  ERRO
}

enum EntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DELETED
  UNKNOWN
}

enum RuleLevel {
  CAMPAIGN
  ADSET
  AD
}

enum RuleAction {
  ATIVAR
  PAUSAR
  AJUSTAR_ORCAMENTO
}

enum RuleRunStatus {
  SUCESSO
  SEM_ACAO
  ERRO
}

enum PixelEventType {
  LEAD
  ADD_TO_CART
  INITIATE_CHECKOUT
  PURCHASE
}

enum PurchaseSendMode {
  TODAS
  APENAS_APROVADAS
}

enum PurchaseValueMode {
  VALOR_DA_VENDA
  VALOR_FIXO
}

enum ExpenseType {
  TAXA_GATEWAY
  IMPOSTO
  DESPESA_RECORRENTE
  /// Comissão de coprodutor ou afiliado — percentual sobre o faturamento.
  COPRODUCAO
  /// Custo do produto (produção, entrega, plataforma) — percentual ou fixo.
  CUSTO_PRODUTO
}

enum ExpenseCalc {
  PERCENTUAL
  FIXO
}

enum ExpenseRecurrence {
  UNICA
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

enum NotificationType {
  VENDA_PENDENTE
  VENDA_APROVADA
  RELATORIO
  REGRA_EXECUTADA
  SISTEMA
}

enum ReportPattern {
  STATUS_LUCRO
  RESUMO_DETALHADO
  NOTIFICACOES_CRIATIVAS
}

// ───────────────────────────── Usuário ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  image        String?
  /// Separador aleatório único usado no `xcod` da Hotmart para o parsing
  /// reverso dos UTMs (Bloco 11). Gerado sob demanda e persistido.
  xcodSeparator String?
  /// Fuso de referência de TODA agregação por dia/hora. Os instantes continuam
  /// gravados em UTC; este campo é o que define onde o dia começa e termina
  /// para este usuário. Ver `src/lib/timezone.ts`.
  timezone      String   @default("America/Sao_Paulo")
  /// Padrões de host de ambiente de teste APROVADOS por este usuário, como
  /// `[{ "padrao": "moldes-*-escopo.vercel.app", "criadoEm": "..." }]`.
  ///
  /// 🔴 Só entram por APROVAÇÃO explícita (`npm run eventos:marcar --aplicar`),
  /// e bloqueiam o envio à CAPI na ingestão. Por isso são removíveis na tela
  /// (Integrações › Testes) — bloquear é irreversível, a lista não pode ser.
  testHostPatterns Json?
  /// Quando o usuário concluiu (ou pulou) o assistente de primeiro acesso.
  /// Nulo = nunca viu o onboarding. É o que impede o assistente de reaparecer
  /// a cada login — a marcação fica no banco, não no navegador.
  onboardingCompletedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adProfiles           AdProfile[]
  adAccounts           AdAccount[]
  clicks               Click[]
  sales                Sale[]
  webhooks             Webhook[]
  apiCredentials       ApiCredential[]
  pixelConfigs         PixelConfig[]
  automationRules      AutomationRule[]
  notifications        Notification[]
  expenses             Expense[]
  notificationSettings NotificationSettings?
  dashboardPreference  DashboardPreference?
  webhookLogs          WebhookLog[]
  dashboardLayouts     DashboardLayout[]
  pixelEvents          PixelEvent[]
  workspaces           Workspace[]

  /// Última Área de Trabalho aberta, para a ferramenta voltar onde parou.
  /// Nulo = sem preferência: o código cai na área PRINCIPAL, nunca num estado
  /// "sem área". `SetNull` porque excluir a área não pode derrubar o usuário.
  lastWorkspaceId String?
  lastWorkspace   Workspace? @relation("UltimaArea", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
}

/// Área de Trabalho: um CONJUNTO DE FILTROS salvo com um nome.
///
/// ⚠️ **Não é multi-tenant.** Os dados continuam todos do usuário, na mesma
/// tabela, sem isolamento — a área só decide o que a tela mostra. Foi uma
/// decisão explícita: a alternativa (projectId em 18 tabelas) exigia migração
/// irreversível e regeneração de scripts, e não resolvia nada a mais para o
/// caso de uso, que é "duas ofertas que não quero ver misturadas".
///
/// Excluir uma área NÃO apaga dado nenhum.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// Cor do marcador na UI (hex). Opcional.
  color     String?
  /// Anotação livre do usuário ("Oferta de emagrecimento — BR"). Só descreve.
  description String?
  /// Área PRINCIPAL do usuário: existe sempre, é criada sozinha e **não pode
  /// ser excluída nem arquivada**. É o padrão quando não há preferência salva.
  /// Um índice parcial único (`Workspace_userId_default_key`) garante no BANCO
  /// que exista no máximo uma por usuário — o `WHERE "isDefault"` do índice é
  /// o que permite N áreas secundárias com `false`.
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Filtros da área. Listas VAZIAS significam "não filtra por este campo" —
  /// diferente de uma lista com itens, que restringe.
  accountIds String[] @default([])
  /// Nomes de produto. São texto livre vindo do gateway: se o produto for
  /// renomeado lá, o casamento silenciosamente para. A tela de gerenciar
  /// mostra quantas vendas cada um casou justamente para isso ficar visível.
  products   String[] @default([])
  sources    String[] @default([])
  /// Ids de `Webhook`. É o filtro de venda MAIS confiável que existe aqui:
  /// `Sale.webhookId` é uma FK de verdade, então não quebra em silêncio quando
  /// o produto é renomeado no gateway — ao contrário de `products`.
  webhookIds     String[] @default([])
  /// Ids de `PixelConfig`, casando com `PixelEvent.pixelConfigId`.
  pixelConfigIds String[] @default([])

  /// ⚖️ **Desempate por produto — só vale quando o webhook é AMBÍGUO.**
  ///
  /// Não é filtro e não entra na precedência normal. Existe para um caso de
  /// borda único: o gateway que só permite UMA URL de webhook global, com duas
  /// ofertas que precisam ficar em áreas diferentes. Aí o webhook deixa de
  /// discriminar (está em duas áreas) e é este campo que decide.
  ///
  /// ⚠️ Os nomes vêm da lista de produtos **já descobertos** — a UI nunca
  /// oferece texto livre. Se o produto for renomeado no gateway o desempate
  /// simplesmente para de casar e a venda cai na Principal **com aviso na
  /// tela**, que é a degradação segura. É por isso que ele pode ser texto:
  /// falhar aqui não produz número errado, produz um aviso.
  produtosDesempate String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  layouts        DashboardLayout[]
  usuariosNaArea User[]            @relation("UltimaArea")

  /// Configuração que PERTENCE à área. Todas com `onDelete: SetNull`:
  /// excluir uma área não pode apagar webhook nem pixel — mataria integração
  /// instalada e viva. Elas voltam a ser da Principal (catch-all).
  adAccounts     AdAccount[]
  webhooks       Webhook[]
  pixelConfigs   PixelConfig[]
  automationRules AutomationRule[]
  expenses       Expense[]
  apiCredentials ApiCredential[]
  clicks         Click[]

  @@index([userId])
}

// ─────────────────── Facebook: perfis, contas, estrutura ───────────────────

/// Perfil do Facebook conectado via OAuth. Um perfil pode expor várias
/// contas de anúncio — reflete o padrão "Mary Barbosa (19)" da interface.
model AdProfile {
  id             String    @id @default(cuid())
  fbUserId       String
  name           String
  email          String?
  pictureUrl     String?
  accessToken    String
  tokenExpiresAt DateTime?
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Quando a última sincronização **terminou com sucesso**. É o que a UI mostra
  /// como "atualizado há X" — por isso não é tocado numa tentativa que falhou.
  lastSyncedAt   DateTime?
  /// Última atualização SÓ das métricas (1 chamada à Graph). Roda muito mais
  /// vezes que a completa — ver `autoSync.ts`.
  lastMetricsAt  DateTime?
  /// Quando a sincronização atual foi RESERVADA. Serve de trava distribuída: o
  /// polling roda a cada poucos segundos em várias abas, e sem isso cada
  /// requisição dispararia uma sincronização concorrente contra a Graph API.
  syncLockedAt   DateTime?

  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts AdAccount[]

  @@unique([userId, fbUserId])
  @@index([userId])
}

model AdAccount {
  id          String       @id @default(cuid())
  fbAccountId String
  name        String
  currency    String       @default("BRL")
  timezone    String?
  status      EntityStatus @default(ACTIVE)
  /// `account_status` CRU da Meta (1 ativa, 2 desabilitada, 101 encerrada...).
  ///
  /// 🔴 `Int?` e nao enum, pelo mesmo motivo de `Campaign.effectiveStatus`: a
  /// Meta acrescenta codigo sem avisar, e um enum faria o SYNC FALHAR num valor
  /// novo em vez de apenas exibi-lo sem traducao. Quem traduz e
  /// `lib/facebook/contaStatus.ts`.
  ///
  /// ⚠️ NULO = conta sincronizada antes desta coluna existir. NAO e "com
  /// problema": se nulo alarmasse, toda conta apareceria em vermelho no dia do
  /// deploy. Mesma licao do `effectiveStatus`.
  accountStatus Int?
  /// Ultima mensagem de erro da Graph API para ESTA conta, crua.
  ///
  /// 🔴 `syncUserMetrics` faz try/catch POR CONTA: uma conta que falha nao
  /// derruba as outras, o ciclo termina "com sucesso", `lastMetricsAt` avanca e
  /// a conta quebrada fica INVISIVEL. Foi assim que duas contas de um testador
  /// passaram dois dias sem gravar metrica sem nada na tela.
  ///
  /// Guardamos o texto CRU. A traducao para linguagem de tela vive em
  /// `lib/facebook/erroMeta.ts` e a lista dela e necessariamente incompleta —
  /// apagar o original tornaria o erro real irrecuperavel.
  lastSyncError    String?
  lastSyncErrorAt  DateTime?
  /// Falhas consecutivas. Zera no primeiro sucesso.
  ///
  /// ⚠️ Existe para a tela poder distinguir "falhou agora" de "falha ha dois
  /// dias" sem ninguem precisar clicar em Sincronizar.
  syncErrorCount   Int      @default(0)
  /// Toggle individual de rastreamento na tela de Contas.
  trackingEnabled Boolean  @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adProfileId String?
  adProfile   AdProfile? @relation(fields: [adProfileId], references: [id], onDelete: SetNull)
  /// Área dona desta conta. **Uma conta pertence a no máximo UMA área** — e
  /// agora isso é estrutural (uma coluna só não comporta dois donos), não uma
  /// checagem em código como era com `Workspace.accountIds`.
  ///
  /// NULO = sem dono: aparece na Principal, que é catch-all. É o estado de
  /// toda conta existente após a migração e de toda conta nova descoberta na
  /// BM — atribuir sozinho violaria a regra de uma área só, em silêncio.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  campaigns    Campaign[]
  adSets       AdSet[]
  ads          Ad[]
  pixelConfigs PixelConfig[]

  @@unique([userId, fbAccountId])
  @@index([workspaceId])
  @@index([userId])
  @@index([adProfileId])
}

model Campaign {
  id           String       @id @default(cuid())
  fbCampaignId String
  name         String
  status       EntityStatus @default(UNKNOWN)
  /// `effective_status` da Meta, **cru**, como ela devolveu.
  ///
  /// 🔴 NÃO é o mesmo que `status`. `status` é o que foi CONFIGURADO; este é se
  /// está REALMENTE veiculando. Uma campanha `ACTIVE` pode não entregar nada —
  /// conjunto pausado, anúncio reprovado, conta sem forma de pagamento, fora da
  /// janela de agendamento. A divergência entre os dois é a resposta para "por
  /// que minha campanha não está rodando".
  ///
  /// ⚠️ Guardado como STRING crua, não como enum: a Meta acrescenta valores
  /// (`PENDING_BILLING_INFO`, `PREAPPROVED`…) sem aviso, e um enum faria o sync
  /// **falhar** num valor novo em vez de apenas exibi-lo sem tradução. A
  /// tradução para linguagem simples vive em `lib/ads/veiculacao.ts`.
  ///
  /// ⚠️ NULO = ainda não sincronizado com o código que pede o campo. A tela
  /// trata nulo como "não informado", nunca como "não está veiculando".
  effectiveStatus String?
  objective       String?
  /// Orçamento no nível da CAMPANHA = campanha CBO. Nulo = ABO (o orçamento
  /// vive nos conjuntos). É essa a detecção usada no modal de orçamento.
  dailyBudget    Decimal?     @db.Decimal(14, 2)
  lifetimeBudget Decimal?     @db.Decimal(14, 2)
  /// `bid_strategy` da Meta (LOWEST_COST_WITHOUT_CAP, COST_CAP, …).
  bidStrategy    String?
  startTime      DateTime?
  stopTime       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adSets      AdSet[]
  ads         Ad[]

  @@unique([adAccountId, fbCampaignId])
  @@index([adAccountId])
}

model AdSet {
  id               String       @id @default(cuid())
  fbAdSetId        String
  name             String
  status           EntityStatus @default(UNKNOWN)
  /// `effective_status` cru da Meta. Ver o comentário em `Campaign`.
  /// No conjunto o valor mais informativo é `CAMPAIGN_PAUSED`: o conjunto está
  /// ativo e não entrega porque a campanha acima dele está pausada.
  effectiveStatus  String?
  dailyBudget      Decimal?     @db.Decimal(14, 2)
  lifetimeBudget   Decimal?     @db.Decimal(14, 2)
  /// Bid cap (`bid_amount` da Meta), em reais.
  bidAmount        Decimal?     @db.Decimal(14, 2)
  optimizationGoal String?
  /// Países da segmentação geográfica (`targeting.geo_locations`), ISO-2.
  ///
  /// É o que o ANUNCIANTE configurou — não uma inferência nossa. Serve para
  /// desempatar o país de um clique quando o IP contradiz a campanha que o
  /// trouxe (ver `lib/geo/desempate.ts`).
  ///
  /// ⚠️ VAZIO = campanha mundial **ou** segmentação ainda não sincronizada. Nos
  /// dois casos não desempata: lista vazia vale para todos.
  geoCountries     String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads         Ad[]

  @@unique([adAccountId, fbAdSetId])
  @@index([campaignId])
  @@index([adAccountId])
}

model Ad {
  id     String       @id @default(cuid())
  fbAdId String
  name   String
  status EntityStatus @default(UNKNOWN)
  /// `effective_status` cru da Meta. Ver o comentário em `Campaign`.
  /// É no ANÚNCIO que a Meta é mais específica: `DISAPPROVED`,
  /// `PENDING_REVIEW`, `ADSET_PAUSED`, `PENDING_BILLING_INFO`.
  effectiveStatus String?
  createdAt       DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId     String
  adSet       AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  creative     Creative?
  dailyMetrics DailyAdMetric[]

  @@unique([adAccountId, fbAdId])
  @@index([campaignId])
  @@index([adSetId])
  @@index([adAccountId])
}

model Creative {
  id           String   @id @default(cuid())
  fbCreativeId String?
  name         String?
  title        String?
  body         String?
  thumbnailUrl String?
  imageUrl     String?
  videoId      String?
  callToAction String?
  linkUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adId String @unique
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)
}

// ─────────────────── Métricas diárias sincronizadas ───────────────────

model DailyAdMetric {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  cpc         Decimal  @default(0) @db.Decimal(14, 4)
  cpm         Decimal  @default(0) @db.Decimal(14, 4)
  reach       Int      @default(0)
  frequency   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adId String
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([date])
  @@index([adId])
}

// ─────────────────── Rastreamento de tráfego ───────────────────

model Click {
  id String @id @default(cuid())
  /// UUID público exposto ao navegador e devolvido pelo checkout.
  clickId     String   @unique @default(uuid())
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  gclid       String?
  ttclid      String?
  url         String?
  referrer    String?
  ip          String?
  userAgent   String?
  country     String?
  timestamp   DateTime @default(now())

  /// Este clique veio de um robô (crawler, navegador automatizado, ferramenta
  /// HTTP)? Decidido SÓ pelo `userAgent` — ver `lib/bots/classificar.ts`.
  ///
  /// ⚠️ O clique é MARCADO, nunca bloqueado: a linha é sempre gravada. Um falso
  /// positivo que apagasse a linha sumiria com um cliente sem deixar rastro;
  /// marcado, ele se corrige com `npm run bot:reclassificar`.
  ///
  /// ⛔ País e IP de datacenter NÃO são critério. Neste produto 55,6% do tráfego
  /// humano vem do navegador embutido do Instagram/Facebook, que sai pela
  /// infraestrutura da Meta — ali, IP de datacenter é sinal de usuário REAL.
  bot         Boolean  @default(false)
  /// Qual padrão casou. Existe para o usuário auditar se o filtro exagera.
  botMotivo   String?

  /// De ONDE veio o `country`: ip · carrier · locale · idioma · campanha ·
  /// header · incerto. Sem isto não há como auditar a geolocalização nem como a
  /// tela indicar que um país é estimativa.
  countrySource  String?
  /// `Accept-Language` da requisição. Mais rico que o locale do user agent
  /// (traz lista com pesos). Funciona com o script JÁ instalado.
  acceptLanguage String?
  /// Fuso do navegador (`Intl.DateTimeFormat().resolvedOptions().timeZone`).
  /// Sinal GEOGRÁFICO direto, não linguístico. Só chega de quem reinstalar o
  /// script — coletado agora porque não dá para voltar no tempo.
  timezone       String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales  Sale[]
  /// Área DECLARADA pelo script de UTM instalado na página (`ws` no payload).
  ///
  /// ⚠️ Ela **não vence a conta de anúncio**. Se o clique tem `utm_campaign`
  /// atribuível, a área é a da conta que pagou por ele — senão o gasto ficaria
  /// numa área e a visita em outra, quebrando as duas ao mesmo tempo. Este
  /// campo resolve o tráfego **não atribuível** (orgânico, direto, outros
  /// canais), que antes caía todo na Principal independentemente da página.
  ///
  /// NULO = script antigo, sem o parâmetro. Comportamento idêntico ao de antes,
  /// então nenhum clique histórico muda de área.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([clickId])
  @@index([utmCampaign])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([fbclid])
  @@index([ip])
  @@index([workspaceId])
  @@index([userId, bot, timestamp])
}

model Sale {
  id            String        @id @default(cuid())
  externalId    String?
  /// Agrupador do checkout: order bump e upsell compartilham o pedido da compra
  /// principal. NULO = venda antiga, anterior à migration — ela é o próprio
  /// pedido, que é o comportamento de sempre.
  ///
  /// ⚠️ Faturamento soma LINHAS; conversões (vendas, CPA, funil, taxa de
  /// aprovação) contam PEDIDOS DISTINTOS. Ver `lib/pedidos.ts`.
  pedidoId      String?
  /// "principal" | "orderbump" | "upsell".
  itemTipo      String        @default("principal")
  value         Decimal       @db.Decimal(14, 2)
  currency      String        @default("BRL")
  product       String
  productId     String?
  status        SaleStatus    @default(PENDENTE)
  paymentMethod PaymentMethod @default(OUTRO)
  buyerEmail    String?
  buyerName     String?
  buyerPhone    String?
  country       String?
  /// De onde veio o `country` da venda: payload · ip · clique · payload_cru.
  countrySource String?
  /// Taxa do gateway REPORTADA por ele nesta venda.
  ///
  /// ⚠️ NULO = o gateway não informou → `lib/financeiro.ts` cai na taxa
  /// cadastrada em Taxas e Despesas. ZERO = ele informou que não cobrou.
  /// Os dois significam coisas diferentes; ver a REGRA 1 em
  /// `lib/gateways/contrato.ts`.
  /// Cookie `_fbc` da Meta, como o gateway o enviou — o MESMO que está no
  /// navegador do comprador. Preferido na CAPI: fabricar um com `Date.now()`
  /// produz um timestamp de processamento, não o do clique no anúncio.
  fbc           String?
  /// Cookie `_fbp` da Meta. Melhora a correspondência da CAPI; não casa clique.
  fbp           String?
  taxaGateway   Decimal?      @db.Decimal(14, 2)
  /// Comissão de coprodutor/afiliado reportada pelo gateway. Mesma regra do
  /// NULO acima.
  coproducao    Decimal?      @db.Decimal(14, 2)
  /// Como o clique de origem foi encontrado: "direct" | "ip" | "none".
  matchMethod   String?
  /// Gateway de origem, gravado NA INGESTÃO — `KIRVANO`, `CAKTO`, `API`…
  ///
  /// 🔴 Existe porque a procedência não pode viver só na FK. `Sale.webhookId` é
  /// `SetNull`, então excluir um webhook (trocar de gateway) apagava para sempre
  /// a única forma de saber de onde a venda veio: `sale.webhook.platform`. A
  /// venda sobrevivia — correto — mas ficava indistinguível de uma ingerida por
  /// chave de API, que também nasce com `webhookId` nulo.
  ///
  /// ⚠️ NULO = venda anterior a esta coluna cujo webhook **já não existia** no
  /// backfill. Não significa "sem gateway".
  platform      String?

  /// ## Cópia dos UTMs do clique, gravada NA INGESTÃO
  ///
  /// 🔴 Mesma classe do `platform` acima. A campanha de uma venda só existia via
  /// `sale.click.utmCampaign` — e `Sale.clickId` é `onDelete: SetNull`. Apagar o
  /// clique mantinha o dinheiro e apagava, para sempre, de onde ele veio: é daí
  /// que saem ROAS, CPA, criativo e a atribuição por área.
  ///
  /// > ### ⛔ PRECEDÊNCIA DE LEITURA: a cadeia `Sale → Click` VENCE a cópia
  /// > O clique é a fonte; isto é o seguro. Enquanto o clique existir, ler dele
  /// > mantém uma resposta só para "de qual campanha é esta venda" — duas fontes
  /// > para a mesma pergunta divergem sempre, e foi assim que a tela de Áreas já
  /// > mostrou "Sem webhook" para uma área com webhook. Ver
  /// > `lib/vendas/utmsDaVenda.ts`, que é o único ponto que decide isso.
  ///
  /// ⚠️ NULO = venda anterior à coluna, ou venda sem clique casado. Não é
  /// "veio sem campanha".
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  /// `fbclid` do clique casado. Diferente de `fbc`, que vem do gateway: este é o
  /// que o NOSSO script viu no navegador do comprador.
  fbclid      String?

  rawPayload    Json?
  timestamp     DateTime      @default(now())
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickId   String?
  click     Click?   @relation(fields: [clickId], references: [id], onDelete: SetNull)
  webhookId String?
  webhook   Webhook? @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  /// Credencial que ingeriu esta venda, quando ela veio pela chave de API em
  /// vez de um webhook. Sem esta coluna, `ApiCredential.workspaceId` não teria
  /// como alcançar a venda: ela nasce com `webhookId` NULO e ficaria presa na
  /// Principal para sempre.
  apiCredentialId String?
  apiCredential   ApiCredential? @relation(fields: [apiCredentialId], references: [id], onDelete: SetNull)

  notifications Notification[]

  @@unique([userId, externalId])
  @@index([clickId])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([userId, pedidoId])
  @@index([userId, platform])
  @@index([status])
  @@index([buyerEmail])
}

// ─────────────────── Integrações ───────────────────

model Webhook {
  id   String @id @default(cuid())
  name String
  /// Segmento público da URL: /api/webhook/sale/{token} (ou ?id={token} na Kirvano)
  token       String          @unique @default(uuid())
  /// Id do gateway no REGISTRO (`lib/gateways/registro.ts`), que é o dono do
  /// domínio — não o banco. Era um enum, e cada gateway novo custava uma
  /// migration; hoje quem valida é `gatewayValido()` em `createWebhook`.
  ///
  /// ⚠️ Valor desconhecido não recusa a venda: `gatewayDoWebhook()` cai no
  /// parser genérico. Perder o parser dedicado é ruim; perder a venda é pior.
  platform    String          @default("CUSTOM")
  active      Boolean         @default(true)
  /// Token de segurança configurado pelo usuário no painel do gateway
  /// (ex.: Kirvano). Validado a cada evento recebido.
  secret      String?
  lastEventAt DateTime?
  eventCount  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales  Sale[]
  /// Área dona deste webhook. NULO = sem dono, aparece na Principal.
  ///
  /// ⚠️ `SetNull`, nunca `Cascade`: excluir uma área **não pode** apagar o
  /// webhook — a URL já está colada no painel do gateway e continuaria
  /// recebendo venda que não teria mais onde cair. Ele volta para a Principal.
  ///
  /// ⚠️ O `token` (o que vai na URL) **não muda** ao trocar de área. Nenhum
  /// identificador já emitido muda de significado — regra permanente.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([token])
  @@index([workspaceId])
}

/// Chave de API própria da Traffik: autentica o envio de eventos de venda
/// por qualquer sistema externo (integração genérica — bloco direito da aba
/// Webhooks). A chave completa é guardada para permitir "revelar".
model ApiCredential {
  id   String @id @default(cuid())
  name String
  /// Chave encriptada (AES-256-GCM). Só é decriptada no botão "revelar";
  /// a autenticação das requests usa o `keyHash`.
  key String @unique
  /// Hash determinístico da chave em texto puro — é por ele que o endpoint
  /// `/api/webhook/ingest` encontra a credencial (o ciphertext tem IV aleatório
  /// e não serve para busca). Nulo só em registros anteriores à migração.
  keyHash    String?   @unique
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales Sale[]
  /// Área dona da chave. Venda ingerida por API nasce com `webhookId` NULO e,
  /// sem isto, nunca poderia pertencer a área secundária sem clique atribuído —
  /// cairia sempre na Principal. Com a área na credencial, a ingestão genérica
  /// tem o mesmo poder de recorte que um webhook.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([key])
  @@index([workspaceId])
}

/// Layout do grid arrastável do Dashboard (Bloco 2). Uma linha por
/// usuário × viewport, porque desktop e mobile têm arranjos independentes.
model DashboardLayout {
  id String @id @default(cuid())
  /// "desktop" | "mobile" — o breakpoint do react-grid-layout.
  viewport String
  /// Array de `{ i, x, y, w, h }` do react-grid-layout, mais os blocos
  /// visíveis. Fica como Json porque o formato é ditado pela lib.
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Layout por Área de Trabalho.
  /// ⚠️ NULO é LEGADO: era o layout da extinta visão "Todas as áreas". A
  /// migration 20260729120000 migrou todos para a área principal. A coluna
  /// segue nullable só porque o banco é compartilhado com um build antigo em
  /// produção que ainda insere NULL — o NOT NULL entra num deploy futuro.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Postgres trata NULL como distinto em UNIQUE. Isso era o que deixava a
  // linha do consolidado conviver com as das áreas; hoje é só uma herança.
  @@unique([userId, workspaceId, viewport])
  @@index([userId])
  @@index([workspaceId])
}

/// Evento recebido do script de pixel próprio (Bloco 5). Antes os eventos só
/// eram repassados à CAPI e descartados — sem persistir não havia como contar
/// o "Initiate Checkout" no funil de conversão.
model PixelEvent {
  id String @id @default(cuid())
  /// "Lead" | "AddToCart" | "InitiateCheckout" — o nome do evento na CAPI.
  event     String
  /// Id gerado no cliente; guardado para depuração/dedup futura.
  eventId   String?
  url       String?
  fbclid    String?
  /// Estado do espelho no pixel nativo (`fbq`), reportado pelo script:
  /// `ok` (saiu na hora) · `adiado` (enfileirado, aguardando o `fbq`) ·
  /// `adiado-ok` (saiu depois da espera) · `sem-fbq` (o `fbq` nunca apareceu) ·
  /// `erro` · `alheio` (o dono deste evento não é a Traffik).
  ///
  /// ⚠️ NULO = evento gravado por um script ANTERIOR a esta coluna, ou pelo
  /// caminho server-side. Não é "falhou" — sem esta distinção, todo evento
  /// histórico apareceria como espelho quebrado.
  espelho   String?
  /// Assinatura do que o SCRIPT INSTALADO detecta, reportada por ele em todo
  /// evento (ver `lib/pixel/detectores.ts`). É o que permite a gaveta comparar
  /// o snippet que está no site do cliente com a regra ao vivo.
  ///
  /// ⚠️ NULO = evento de um script anterior a esta coluna, ou gerado pelo
  /// servidor (o `InitiateCheckout` que nasce do webhook do gateway). Não é
  /// "detector vazio" — é "não informado".
  detectores String?
  /// Ambiente de origem, derivado da `url` (ver `lib/pixel/ambiente.ts`):
  /// `preview` · `local` · `tunel`.
  ///
  /// ⚠️ NULO = **produção, ou não sabemos** — e é o padrão de propósito. O
  /// evento server-side (o InitiateCheckout que nasce do webhook do gateway)
  /// não tem URL, e marcar por omissão o tiraria do funil.
  ///
  /// Evento marcado **continua gravado**: sai do funil e do feed, e a tela diz
  /// quantos foram. Marcar em vez de apagar é o que torna um erro de detecção
  /// visível e reversível, em vez de perda silenciosa.
  ambiente  String?
  timestamp DateTime @default(now())

  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixelConfigId String?

  @@index([userId, event, timestamp])
  /// Deduplicação, possível só desde que o `eventId` virou determinístico.
  /// PARCIAL (`WHERE "eventId" IS NOT NULL`) — ver a migration
  /// `20260731040000_pixel_event_dedup`; o Prisma não expressa índice parcial,
  /// então a declaração real vive no SQL e isto aqui é o espelho dela.
  @@unique([userId, event, eventId])
}

/// Log cru de cada payload recebido por webhook — alimenta o "Teste de Webhook"
/// da aba Testes (Bloco 13). É gravado ANTES do processamento, para que um
/// payload que quebre no meio do caminho ainda apareça no diagnóstico.
model WebhookLog {
  /// Gateway de origem: valor de WebhookPlatform ou "API" (ingest genérico).
  gateway String
  id      String @id @default(cuid())
  /// Corpo cru recebido, exatamente como chegou.
  payloadRaw Json
  status     WebhookLogStatus @default(RECEBIDO)
  /// Motivo da rejeição / mensagem de erro, quando houver.
  message    String?
  httpStatus Int?
  /// Venda criada ou atualizada por este payload, quando o processamento deu certo.
  saleId    String?
  createdAt DateTime @default(now())

  /// Nulo quando nem deu para identificar o dono (ex.: token desconhecido).
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookId String?

  @@index([userId, createdAt])
  @@index([gateway])
}

model PixelConfig {
  id      String @id @default(cuid())
  name    String
  /// ID do pixel na Meta (legado Fase 10 — agora os pixels ficam em MetaPixel).
  pixelId String?
  /// Token da Conversions API para envio server-side (legado — ver MetaPixel).
  /// Encriptado em repouso (AES-256-GCM) — ver `src/lib/crypto/secrets.ts`.
  accessToken String?
  provider    String   @default("META")
  enabled     Boolean  @default(true)
  /// Quem envia cada evento para a Meta: `{ "Purchase": "traffik" | "gateway" | "ninguem" }`.
  ///
  /// 🔴 NULO = tudo da Traffik (comportamento anterior). Evento ausente do mapa
  /// também cai em `traffik` — o padrão nunca é "não envia", porque deixar de
  /// enviar em silêncio é o modo de falha caro aqui.
  ///
  /// Json em vez de coluna por evento porque `PageView` não existe no enum
  /// `PixelEventType`, e uma FK para `PixelEventRule` o deixaria de fora.
  eventOwners Json?
  /// Respostas do preset da gaveta: `{ "temPixelNativo": true }`.
  ///
  /// Uma pergunta em vez de 20 escolhas — e ela amarra duas coisas que precisam
  /// concordar: o dono de cada evento (lido AO VIVO pelo servidor) e se o script
  /// espelha no `fbq` (ASSADO no snippet). Separadas, elas divergem, e a
  /// divergência conta conversão em dobro. Ver `lib/pixel/preset.ts`.
  ///
  /// ⚠️ NULO = pixel anterior a esta coluna. `lerPreset()` **infere** do dono do
  /// PageView, o que reproduz exatamente o comportamento em vigor: o padrão do
  /// projeto já é `PageView: "navegador"`, então todo pixel existente infere
  /// "tem pixel nativo". Não é "sem preset" — é "ainda não perguntamos".
  setup       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccountId String?
  adAccount   AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  /// Área dona deste pixel. NULO = sem dono, aparece na Principal.
  /// `SetNull` pelo mesmo motivo do webhook: o script já está instalado no site
  /// do cliente e o `PixelConfig.id` embutido nele não pode mudar de sentido.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  metaPixels MetaPixel[]
  eventRules PixelEventRule[]

  @@index([userId])
  @@index([adAccountId])
  @@index([workspaceId])
}

/// Um pixel da Meta vinculado a um PixelConfig. Um "Pixel" da Traffik pode
/// disparar para vários pixels da Meta ao mesmo tempo (Bloco 12).
model MetaPixel {
  id      String @id @default(cuid())
  pixelId String
  /// Token da Conversions API, encriptado em repouso (AES-256-GCM).
  /// Só é decriptado no momento de chamar a CAPI — ver `src/lib/crypto/secrets.ts`.
  accessToken String?
  nickname    String?
  createdAt   DateTime @default(now())

  pixelConfigId String
  pixelConfig   PixelConfig @relation(fields: [pixelConfigId], references: [id], onDelete: Cascade)

  @@index([pixelConfigId])
}

model PixelEventRule {
  id        String         @id @default(cuid())
  eventType PixelEventType
  enabled   Boolean        @default(false)
  /// Regra de detecção no cliente, ex.: { "tipo": "contem_texto", "valor": "COMPRAR AGORA" }
  detection Json?

  // Específicos do evento Purchase
  sendMode      PurchaseSendMode?  @default(APENAS_APROVADAS)
  valueMode     PurchaseValueMode? @default(VALOR_DA_VENDA)
  fixedValue    Decimal?           @db.Decimal(14, 2)
  targetProduct String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pixelConfigId String
  pixelConfig   PixelConfig @relation(fields: [pixelConfigId], references: [id], onDelete: Cascade)

  @@unique([pixelConfigId, eventType])
  @@index([pixelConfigId])
}

// ─────────────────── Automação ───────────────────

model AutomationRule {
  id            String    @id @default(cuid())
  name          String
  targetProduct String?
  /// Produtos alvo (vários). `targetProduct` fica como legado de "um produto".
  /// Vazio = todos os produtos.
  targetProducts String[] @default([])
  /// 🔴 TETO DE ORÇAMENTO — obrigatório para AUMENTAR orçamento.
  ///
  /// Sem ele, uma regra de "+20%" multiplica o orçamento a cada execução, com
  /// dinheiro real: 100 → 120 → 144 → 173… O motor **recusa aumentar quando
  /// este campo é nulo** (ausência de configuração nunca vira permissão — mesma
  /// regra da autenticação de cron e webhook) e **trava no teto** quando o novo
  /// valor passaria dele.
  maxBudget     Decimal?  @db.Decimal(14, 2)
  /// Janela de horário em que a regra pode rodar, na HORA LOCAL do usuário
  /// (0–23). Nulos = qualquer hora. `start > end` atravessa a meia-noite
  /// (ex.: 22 → 6). Lida com `hourInTz`, nunca com `getHours()`.
  windowStartHour Int?
  windowEndHour   Int?
  /// IDs de AdAccount alvo; vazio = todas as contas do usuário.
  adAccountIds  String[]  @default([])
  level         RuleLevel @default(CAMPAIGN)
  nameFilter    String?
  action        RuleAction
  /// Parâmetros da ação, ex.: { "tipo": "percentual", "valor": 20 }
  actionParams  Json?
  /// Condições avaliadas, ex.: [{ "metrica": "cpa", "operador": ">", "valor": 50 }]
  conditions    Json      @default("[]")
  /// Janela de cálculo: "hoje" | "ontem" | "ultimas_3h" | "ultimos_7d" ...
  calcPeriod    String    @default("hoje")
  /// Frequência de checagem em minutos.
  frequencyMin  Int       @default(30)
  dailyRunLimit Int       @default(10)
  active        Boolean   @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs   AutomationRuleLog[]
  /// Área dona desta regra. NULO = regra GLOBAL (vale para todas as áreas) —
  /// é o estado de toda regra existente após a migração.
  ///
  /// 🔴 **Esconder a regra da tela e não escopar o motor seria pior que não
  /// fazer nada.** Uma regra da Área A que pausasse campanha da Área B ficaria
  /// invisível de B, mexendo em orçamento real. Por isso `rules/engine.ts`
  /// intersecta as contas-alvo com as contas da área — as duas coisas andam
  /// juntas, sempre.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([active])
  @@index([workspaceId])
}

model AutomationRuleLog {
  id     String        @id @default(cuid())
  ranAt  DateTime      @default(now())
  status RuleRunStatus
  /// Entidades avaliadas e o que foi feito com cada uma.
  details  Json?
  message  String?
  affected Int    @default(0)

  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, ranAt])
}

// ─────────────────── Notificações ───────────────────

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  content String
  /// Dados extras usados para renderizar o card da notificação.
  data      Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, timestamp])
}

model NotificationSettings {
  id String @id @default(cuid())

  // Notificações de venda
  notifyPendingSale  Boolean @default(true)
  notifyApprovedSale Boolean @default(true)
  showValue          Boolean @default(true)
  showProductName    Boolean @default(true)
  showUtmCampaign    Boolean @default(true)
  showDashboardName  Boolean @default(false)

  // Notificações de relatório (horários fixos)
  report08      Boolean       @default(false)
  report12      Boolean       @default(false)
  report18      Boolean       @default(false)
  report23      Boolean       @default(true)
  reportPattern ReportPattern @default(STATUS_LUCRO)

  /// ⚠️ NÃO USE — o fuso de verdade é `User.timezone`.
  /// Esta coluna existe desde a migration inicial e nunca foi lida por código
  /// nenhum. Cheguei a removê-la, mas o banco Supabase é COMPARTILHADO com a
  /// produção, que roda um build antigo cujo cliente Prisma ainda a seleciona —
  /// o dashboard inteiro passou a dar 500. Só dá para removê-la depois que
  /// todos os ambientes estiverem no código novo.
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────── Taxas e despesas ───────────────────

model Expense {
  id   String      @id @default(cuid())
  name String
  type ExpenseType
  calc ExpenseCalc @default(PERCENTUAL)
  /// Percentual (0–100) quando calc = PERCENTUAL; valor absoluto quando FIXO.
  amount        Decimal        @db.Decimal(14, 4)
  /// Restringe a taxa a uma forma de pagamento; null = todas.
  paymentMethod PaymentMethod?
  recurrence    ExpenseRecurrence @default(UNICA)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 🔴 **NULO = vale para TODAS as áreas**, e é o padrão.
  ///
  /// Taxa de gateway e imposto são genuinamente globais. Migrar as despesas
  /// existentes "para a Principal" faria toda área secundária calcular lucro
  /// **sem imposto nenhum** — e o número continuaria parecendo plausível, que é
  /// exatamente a falha silenciosa que este projeto já pagou caro duas vezes.
  /// Por isso o backfill mantém NULO e o formulário nasce com "aplicar a todas
  /// as áreas" marcado.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([workspaceId])
}

// ─────────────────── Preferências de UI ───────────────────

model DashboardPreference {
  id String @id @default(cuid())
  /// Visibilidade de cada card/seção do dashboard, ex.: { "roas": true, "funil": false }
  visibility Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
